// Special One standings — unlocks as soon as this week's result is recorded
function buildStandings() {
  const MIN_GAMES = 3;
  const REVEAL_WEEKS = 5;
  const teamsSh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("Teams");
  if (!teamsSh) return { unlocked: false, weeksOfData: 0, revealWeeks: REVEAL_WEEKS, minGames: MIN_GAMES, standings: [] };

  const teamsData = teamsSh.getDataRange().getValues().slice(1);
  const weeksOfData = teamsData.length;

  // Unlocked if current week has a result recorded
  const wk = getWeekKey();
  const thisWeekRow = teamsData.filter(r => r[0] === wk);
  const resultRecorded = thisWeekRow.length > 0 && thisWeekRow[thisWeekRow.length-1][6] &&
                         thisWeekRow[thisWeekRow.length-1][6] !== "" &&
                         thisWeekRow[thisWeekRow.length-1][6] !== "Unknown";

  if (!resultRecorded && weeksOfData < REVEAL_WEEKS) {
    return { unlocked: false, weeksOfData, revealWeeks: REVEAL_WEEKS, minGames: MIN_GAMES, standings: [] };
  }

  const playerWL = {};
  teamsData.forEach(r => {
    const result = r[6]; if (!result || result === "Unknown") return;
    const teamA = typeof r[3] === "string" ? r[3].split(",").map(n => n.trim()).filter(Boolean) : [];
    const teamB = typeof r[5] === "string" ? r[5].split(",").map(n => n.trim()).filter(Boolean) : [];
    const processTeam = (team, isWinner) => {
      team.forEach(name => {
        if (!playerWL[name]) playerWL[name] = { wins:0, losses:0, draws:0, played:0 };
        playerWL[name].played++;
        if (result === "Draw") playerWL[name].draws++;
        else if (isWinner) playerWL[name].wins++;
        else playerWL[name].losses++;
      });
    };
    if (result === "Win")  { processTeam(teamA, true);  processTeam(teamB, false); }
    else if (result === "Loss") { processTeam(teamA, false); processTeam(teamB, true); }
    else { processTeam(teamA, false); processTeam(teamB, false); }
  });

  const players = getPlayers();
  const standings = Object.entries(playerWL)
    .filter(([, w]) => w.played >= MIN_GAMES)
    .map(([name, w]) => {
      const pos = (players.find(p => p.name === name) || {}).pos || "";
      const points = w.wins * 3 + w.draws;
      const winRate = w.played ? Math.round(w.wins / w.played * 100) : 0;
      return { name, pos, wins: w.wins, draws: w.draws, losses: w.losses, played: w.played, points, winRate };
    })
    .sort((a, b) => b.points - a.points || b.winRate - a.winRate);

  return { unlocked: true, weeksOfData, revealWeeks: REVEAL_WEEKS, minGames: MIN_GAMES, standings };
}

function buildWeekly(weekKey) {
  const sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("Votes");
  const data = sh.getDataRange().getValues().slice(1).filter(r => r[0] === weekKey);
  const voterSet = {};
  data.forEach(r => voterSet[r[2]] = true);
  const playerMap = {};
  data.forEach(r => {
    if (!playerMap[r[3]]) playerMap[r[3]] = {name: r[3], total: 0, count: 0};
    playerMap[r[3]].total += Number(r[4]); playerMap[r[3]].count++;
  });
  const players = Object.values(playerMap)
    .map(p => ({name: p.name, avg: p.count ? +(p.total/p.count).toFixed(2) : 0, count: p.count}))
    .sort((a,b) => b.avg - a.avg);
  const thisWeekPlayers = getThisWeekPlayerNames();
  const expectedPlayers = thisWeekPlayers.length ? thisWeekPlayers : getPlayerNames();
  return {
    weekKey,
    totalVoters: Object.keys(voterSet).length,
    expectedVoters: expectedPlayers.length,
    pendingVoters: expectedPlayers.filter(p => !voterSet[p]),
    matchResult: data.length ? data[0][5] : "Unknown",
    players,
    voters: Object.keys(voterSet)
  };
}

function buildAllTime() {
  const sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("Votes");
  const data = sh.getDataRange().getValues().slice(1);
  const teamsSh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("Teams");
  const teamsData = teamsSh ? teamsSh.getDataRange().getValues().slice(1) : [];

  // Build sorted list of all unique week keys from Teams sheet
  const allWeekKeys = [...new Set(teamsData.map(r => r[0]))].sort();
  const totalWeeks = allWeekKeys.length;

  // Build per-player first appearance week and games played from Teams sheet
  const playerFirstWeek = {};  // name -> earliest weekKey they appeared
  const playerGamesPlayed = {}; // name -> count of weeks they appeared in Teams
  teamsData.forEach(r => {
    const wk = r[0];
    const teamA = typeof r[3] === "string" ? r[3].split(",").map(n => n.trim()).filter(Boolean) : [];
    const teamB = typeof r[5] === "string" ? r[5].split(",").map(n => n.trim()).filter(Boolean) : [];
    [...teamA, ...teamB].forEach(name => {
      if (!playerFirstWeek[name] || wk < playerFirstWeek[name]) playerFirstWeek[name] = wk;
      if (!playerGamesPlayed[name]) playerGamesPlayed[name] = 0;
      playerGamesPlayed[name]++;
    });
  });

  const playerMap = {}, weekMap = {};
  data.forEach(r => {
    const wk = r[0], p = r[3], rating = Number(r[4]);
    if (!playerMap[p]) playerMap[p] = {name: p, total: 0, count: 0, weeks: {}};
    playerMap[p].total += rating; playerMap[p].count++;
    if (!playerMap[p].weeks[wk]) playerMap[p].weeks[wk] = [];
    playerMap[p].weeks[wk].push(rating);
    if (!weekMap[wk]) weekMap[wk] = {weekKey: wk, result: r[5], voters: {}, scoreA: "", scoreB: "", teamA: [], teamB: [], teamAName: "", teamBName: ""};
    weekMap[wk].voters[r[2]] = true;
  });

  teamsData.forEach(r => {
    const wk = r[0];
    if (!weekMap[wk]) weekMap[wk] = {weekKey: wk, result: r[6], voters: {}, scoreA: "", scoreB: "", teamA: [], teamB: [], teamAName: "", teamBName: ""};
    weekMap[wk].result = r[6] || weekMap[wk].result;
    weekMap[wk].scoreA = r[7] || ""; weekMap[wk].scoreB = r[8] || "";
    weekMap[wk].teamAName = r[2] || ""; weekMap[wk].teamBName = r[4] || "";
    weekMap[wk].teamA = typeof r[3] === "string" ? r[3].split(",").map(n => n.trim()) : [];
    weekMap[wk].teamB = typeof r[5] === "string" ? r[5].split(",").map(n => n.trim()) : [];
  });

  const playerWinLoss = {};
  Object.values(weekMap).forEach(wk => {
    if (!wk.result || wk.result === "Unknown") return;
    const processTeam = (team, isWinner) => {
      team.forEach(name => {
        if (!playerWinLoss[name]) playerWinLoss[name] = {wins: 0, losses: 0, draws: 0, played: 0};
        playerWinLoss[name].played++;
        if (wk.result === "Draw") playerWinLoss[name].draws++;
        else if (isWinner) playerWinLoss[name].wins++;
        else playerWinLoss[name].losses++;
      });
    };
    if (wk.result === "Win") { processTeam(wk.teamA, true); processTeam(wk.teamB, false); }
    else if (wk.result === "Loss") { processTeam(wk.teamA, false); processTeam(wk.teamB, true); }
    else { processTeam(wk.teamA, false); processTeam(wk.teamB, false); }
  });

  // Attendance boost constants
  const MAX_BOOST = 0.20;
  const BOOST_THRESHOLD = 0.30; // 30% attendance minimum to appear; baseline for boost
  const PENALTY = -0.10;        // applied if below 30% (excluded from dashboard so not used, kept for reference)

  // Calculate attendance % for each player based on weeks since first appearance
  const playerAttendance = {};
  Object.keys(playerFirstWeek).forEach(name => {
    const firstWk = playerFirstWeek[name];
    const weeksEligible = allWeekKeys.filter(wk => wk >= firstWk).length;
    const gamesPlayed = playerGamesPlayed[name] || 0;
    playerAttendance[name] = weeksEligible > 0 ? gamesPlayed / weeksEligible : 0;
  });

  // Max attendance across all players (for relative scaling)
  const maxAttendance = Math.max(...Object.values(playerAttendance), 0);

  const players = Object.values(playerMap).map(p => {
    const rawAvg = p.count ? +(p.total/p.count).toFixed(2) : 0;
    const weekKeys = Object.keys(p.weeks).sort();
    const lastTwo = weekKeys.slice(-2);
    let delta = 0;
    if (lastTwo.length === 2) {
      const prev = p.weeks[lastTwo[0]].reduce((a,b) => a+b, 0) / p.weeks[lastTwo[0]].length;
      const curr = p.weeks[lastTwo[1]].reduce((a,b) => a+b, 0) / p.weeks[lastTwo[1]].length;
      delta = +(curr - prev).toFixed(2);
    }
    const wl = playerWinLoss[p.name] || {wins: 0, losses: 0, draws: 0, played: 0};

    // Attendance boost calculation
    const attendance = playerAttendance[p.name] || 0;

    // Exclude players below 30% attendance
    if (attendance < BOOST_THRESHOLD) return null;

    // Linear boost from 0 (at 30%) to MAX_BOOST (at 100%)
    const boostRatio = (attendance - BOOST_THRESHOLD) / (1 - BOOST_THRESHOLD);
    const boost = +(boostRatio * MAX_BOOST).toFixed(3);
    const avg = +Math.min(5.0, rawAvg + boost).toFixed(2);

    return {
      name: p.name, avg, rawAvg, boost, attendance: +attendance.toFixed(2),
      count: p.count, gamesPlayed: weekKeys.length, delta,
      wins: wl.wins, losses: wl.losses, draws: wl.draws, played: wl.played,
      winRate: wl.played ? +(wl.wins / wl.played * 100).toFixed(0) : 0
    };
  }).filter(p => p !== null).sort((a,b) => b.avg - a.avg);

  const recentGames = Object.values(weekMap)
    .sort((a,b) => b.weekKey.localeCompare(a.weekKey)).slice(0, 10)
    .map(w => ({weekKey: w.weekKey, result: w.result, voters: Object.keys(w.voters).length, scoreA: w.scoreA, scoreB: w.scoreB, teamAName: w.teamAName, teamBName: w.teamBName}));

  const anchor = players.filter(p => p.played >= 3).sort((a,b) => b.winRate - a.winRate)[0] || null;
  return {players, recentGames, anchor};
}

function buildPlayerData(playerName) {
  if (!playerName) return {error: "No player"};
  const sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("Votes");
  const data = sh.getDataRange().getValues().slice(1);
  const teamsSh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("Teams");
  const teamsData = teamsSh ? teamsSh.getDataRange().getValues().slice(1) : [];
  const weeklyRatings = {};
  data.filter(r => r[3] === playerName).forEach(r => {
    if (!weeklyRatings[r[0]]) weeklyRatings[r[0]] = [];
    weeklyRatings[r[0]].push(Number(r[4]));
  });
  const ratingHistory = Object.entries(weeklyRatings)
    .sort((a,b) => a[0].localeCompare(b[0]))
    .map(([wk, ratings]) => ({weekKey: wk, avg: +(ratings.reduce((a,b) => a+b, 0) / ratings.length).toFixed(2), count: ratings.length}));
  const wlRecord = {wins: 0, losses: 0, draws: 0, played: 0};
  teamsData.forEach(r => {
    const result = r[6]; if (!result || result === "Unknown") return;
    const teamA = typeof r[3] === "string" ? r[3].split(",").map(n => n.trim()) : [];
    const teamB = typeof r[5] === "string" ? r[5].split(",").map(n => n.trim()) : [];
    const inA = teamA.includes(playerName), inB = teamB.includes(playerName);
    if (!inA && !inB) return;
    wlRecord.played++;
    if (result === "Draw") { wlRecord.draws++; return; }
    if ((result === "Win" && inA) || (result === "Loss" && inB)) wlRecord.wins++;
    else wlRecord.losses++;
  });
  const allRatings = data.filter(r => r[3] === playerName).map(r => Number(r[4]));
  const avg = allRatings.length ? +(allRatings.reduce((a,b) => a+b, 0) / allRatings.length).toFixed(2) : 0;
  const best = ratingHistory.length ? Math.max(...ratingHistory.map(r => r.avg)) : 0;
  const consistency = allRatings.length > 1
    ? +(Math.sqrt(allRatings.map(r => (r-avg)**2).reduce((a,b) => a+b, 0) / allRatings.length)).toFixed(2) : 0;
  return {name: playerName, avg, best, consistency, ratingHistory, wlRecord};
}

function buildWeeklySummary(weekKey) {
  const d = buildWeekly(weekKey);
  if (!d.players.length) return weekKey + " - No votes yet.";
  const mvp = d.players[0];
  return "Weekly Summary - "+weekKey+"\nMVP: "+mvp.name+" ("+mvp.avg+" stars)\nResult: "+d.matchResult+"\nVoters: "+d.totalVoters+"/"+d.expectedVoters+"\n\n"+d.players.map((p,i) => (i+1)+". "+p.name+" - "+p.avg).join("\n");
}

function handleReveal(pin) {
  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const config = ss.getSheetByName("Config");
    if (!config) return {success: false, message: "Config not found."};
    const rows = config.getDataRange().getValues();
    const pinRow = rows.find(r => r[0] === "dashboard_pin");
    if (!pinRow) return {success: false, message: "PIN not configured."};
    const correctPin = String(pinRow[1]).trim();
    if (String(pin).trim() === correctPin) {
      return {success: true, revealed: true};
    }
    return {success: false, message: "Incorrect PIN."};
  } catch(e) {
    return {success: false, message: "Could not reveal."};
  }
}

