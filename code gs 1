function handleTelegramMessage(msg) {
  const text = (msg.text || "").trim();
  const chatId = msg.chat.id;
  const lower = text.toLowerCase();

  if (text.startsWith("/addplayer")) {
    const parts = text.split(" ");
    if (parts.length < 3) { sendTelegram(chatId, "Usage: /addplayer Name POS"); return; }
    const added = addPlayer(parts[1], parts[2]);
    sendTelegram(chatId, added ? parts[1]+" added!" : parts[1]+" already exists.");
    return;
  }
  if (text === "/listplayers") {
    const players = getPlayers();
    sendTelegram(chatId, "Squad ("+players.length+")\n\n"+players.map((p,i) => (i+1)+". "+p.name+" - "+p.pos).join("\n"));
    return;
  }
  if (text === "/status") {
    const wk = getWeekKey();
    sendTelegram(chatId, "Status - "+wk+"\nPending: "+getPendingVoters(wk).length+"\nFlags: "+getFlaggedCount(wk));
    return;
  }
  if (text === "/dashboard") { sendTelegram(chatId, "Dashboard:\n"+CONFIG.DASHBOARD_URL); return; }
  if (text === "/vote") { sendTelegram(chatId, "Vote here:\n"+CONFIG.VOTING_APP_URL); return; }

  const resultKeywords = ["won","win","lost","loss","draw","drew"];
  if (resultKeywords.some(k => lower.includes(k)) && text.split("\n").length <= 3 && !text.startsWith("/")) {
    const result = recordMatchResult(text);
    if (result) sendToGroup("Result recorded: " + result);
    return;
  }

  if (!text.startsWith("/") && (text.includes(":") || text.split("\n").length > 3)) {
    const parsed = parseTeams(text);
    if (parsed) {
      recordTeams(parsed);
      const a = Array.isArray(parsed.teamA) ? parsed.teamA.join(", ") : parsed.teamA;
      const b = Array.isArray(parsed.teamB) ? parsed.teamB.join(", ") : parsed.teamB;
      sendToGroup("Teams recorded!\n"+(parsed.teamAName||"Team A")+": "+a+"\n"+(parsed.teamBName||"Team B")+": "+b);
    }
  }
}

function recordMatchResult(text) {
  try {
    const sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("Teams");
    const data = sh.getDataRange().getValues();
    const wk = getWeekKey();
    const lower = text.toLowerCase();
    let result = lower.includes("won") || lower.includes("win") ? "Win" :
                 lower.includes("lost") || lower.includes("loss") ? "Loss" : "Draw";
    const scoreMatch = text.match(/(\d+)\s*[-:]\s*(\d+)/);
    const scoreA = scoreMatch ? scoreMatch[1] : "";
    const scoreB = scoreMatch ? scoreMatch[2] : "";
    for (let i = data.length-1; i >= 1; i--) {
      if (data[i][0] === wk) {
        sh.getRange(i+1, 7).setValue(result);
        if (scoreA) { sh.getRange(i+1, 8).setValue(scoreA); sh.getRange(i+1, 9).setValue(scoreB); }
        logAudit(wk, "ResultRecorded", text);
        return result + (scoreA ? " ("+scoreA+"-"+scoreB+")" : "");
      }
    }
    return null;
  } catch(e) { Logger.log("recordMatchResult error: "+e); return null; }
}

function parseTeams(text) {
  try {
    const res = UrlFetchApp.fetch("https://api.anthropic.com/v1/messages", {
      method: "post",
      headers: {
        "x-api-key": CONFIG.ANTHROPIC_API_KEY,
        "anthropic-version": "2023-06-01",
        "content-type": "application/json"
      },
      payload: JSON.stringify({
        model: "claude-sonnet-4-6",
        max_tokens: 300,
        messages: [{
          role: "user",
          content: "Extract two teams. Ignore +1 guests. Only include registered players: "
            + getPlayerNames().join(",")
            + ". Reply ONLY with raw JSON (no markdown, no backticks, no explanation): {\"teamAName\":\"...\",\"teamA\":[...],\"teamBName\":\"...\",\"teamB\":[...],\"result\":\"\"}. Message: " + text
        }]
      }),
      muteHttpExceptions: true
    });
    const json = JSON.parse(res.getContentText());
    if (!json.content || !json.content[0]) return null;
    let raw = json.content[0].text.trim();
    raw = raw.replace(/^```(?:json)?\s*/i, "").replace(/```\s*$/i, "").trim();
    return JSON.parse(raw);
  } catch(e) {
    Logger.log("parseTeams error: " + e);
    return null;
  }
}

