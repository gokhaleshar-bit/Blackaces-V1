function detectBias(weekKey) {
  const sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("Votes");
  const voterMap = {};
  sh.getDataRange().getValues().slice(1).filter(r => r[0] === weekKey).forEach(r => {
    if (!voterMap[r[2]]) voterMap[r[2]] = [];
    voterMap[r[2]].push(Number(r[4]));
  });
  const flags = [];
  Object.entries(voterMap).forEach(([voter, ratings]) => {
    const avg = ratings.reduce((a,b) => a+b, 0) / ratings.length;
    if (avg >= 4.8) flags.push(voter + " avg " + avg.toFixed(1) + " - inflation");
    if (avg <= 1.5) flags.push(voter + " avg " + avg.toFixed(1) + " - deflation");
  });
  if (flags.length > 0) { logAudit(weekKey, "BiasFlag", flags.join("; ")); sendToCustodian("Bias flags:\n" + flags.join("\n")); }
}

