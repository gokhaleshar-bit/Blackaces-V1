function getPlayers() {
  const sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("Players");
  if (!sh) return [];
  return sh.getDataRange().getValues().slice(1)
    .filter(r => r[2] === true || r[2] === "TRUE")
    .map(r => ({ name: r[0], pos: r[1] }));
}

function getPlayerNames() { return getPlayers().map(p => p.name); }

function addPlayer(name, pos) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sh = ss.getSheetByName("Players");
  if (!sh) {
    sh = ss.insertSheet("Players");
    sh.getRange(1,1,1,3).setValues([["Name","Position","Active"]]);
    sh.setFrozenRows(1);
  }
  const data = sh.getDataRange().getValues().slice(1);
  if (data.find(r => r[0].toLowerCase() === name.toLowerCase())) return false;
  sh.appendRow([name, pos.toUpperCase(), true]);
  return true;
}

function setupSheets() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheets = {
    Players: ["Name","Position","Active"],
    Votes: ["WeekKey","Date","Voter","RatedPlayer","Rating","MatchResult","Timestamp"],
    Teams: ["WeekKey","Date","TeamAName","TeamA","TeamBName","TeamB","Result","ScoreA","ScoreB","ParsedBy","Timestamp"],
    AuditLog: ["WeekKey","Timestamp","Event","Detail"],
    WeeklySummary: ["WeekKey","TotalVoters","AvgRating","MVP","Timestamp"]
  };
  Object.entries(sheets).forEach(([name, headers]) => {
    let sh = ss.getSheetByName(name);
    if (!sh) sh = ss.insertSheet(name);
    sh.getRange(1,1,1,headers.length).setValues([headers]).setFontWeight("bold");
    sh.setFrozenRows(1);
  });
}

function getWeekKey() {
  const now = new Date();
  const jan1 = new Date(now.getFullYear(), 0, 1);
  const week = Math.ceil(((now - jan1) / 86400000 + jan1.getDay() + 1) / 7);
  return now.getFullYear() + "_w" + week;
}

